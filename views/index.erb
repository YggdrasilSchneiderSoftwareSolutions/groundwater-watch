<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grundwasser Überwachung</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background: #f4f7f6; color: #333; }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; }
        .wert { font-size: 3rem; font-weight: bold; color: #2c3e50; margin: 10px 0; }
        .alarm { color: #c0392b; }
        .status { font-size: 0.85rem; color: #7f8c8d; margin-top: 15px; }
    </style>
</head>
<body>
    <h1>Grundwasser Monitor</h1>

    <div class="card">
        <h3>Letzter Messwert:</h3>
        <% if @daten[:groundwater_level] %>
            <div class="wert <%= 'alarm' if @daten[:groundwater_level] > 4.5 %>">
                <%= @daten[:groundwater_level].to_s.gsub('.', ',') %> m
            </div>
            <p>Stand vom: <%= @daten[:timestamp] %></p>
        <% else %>
            <div class="wert">--</div>
        <% end %>
        
        <div class="status">
            <strong>Systemstatus:</strong> <%= @daten[:status] %>
        </div>
    </div>
    <div class="status">
        <strong>Letzter Abruf:</strong> <%= @daten[:fetch_time] || "Noch kein Abruf erfolgt" %>
    </div>
</body>
</html>